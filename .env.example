# =============================================================================
# Inbox Digest Agent — Local Development Configuration
# Copy this to .env and fill in your values.
# For production, all secrets go to Secret Manager / Terraform vars.
# =============================================================================

# ---------------------------------------------------------------------------
# Google Cloud (Vertex AI or AI Studio)
# ---------------------------------------------------------------------------
# Option A: Vertex AI (recommended for production)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: AI Studio (for local dev with personal Gemini key)
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# LLM model default (local dev only; overridden per-user in production)
# ---------------------------------------------------------------------------
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Gmail OAuth (for local ADK Web UI dev — not needed in ambient/scheduler path)
# ---------------------------------------------------------------------------
OAUTH_CLIENT_ID=your-google-oauth-client-id
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
AUTH_ID=gmail-oauth

# ---------------------------------------------------------------------------
# WhatsApp — Meta Business Cloud API (production)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=your-meta-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Optional: pin API version
# WHATSAPP_API_VERSION=v19.0

# --- OR use Twilio (set WHATSAPP_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_WHATSAPP_FROM=+14155238886

# ---------------------------------------------------------------------------
# Firestore + KMS (production; use in-memory fallback for local dev)
# ---------------------------------------------------------------------------
FIRESTORE_ENABLED=false  # set to true when running with real GCP credentials
FIRESTORE_COLLECTION=users
KMS_ENABLED=false        # set to true in production
GOOGLE_KMS_KEY_NAME=projects/your-project/locations/global/keyRings/inbox-digest-keyring/cryptoKeys/user-secrets

# ---------------------------------------------------------------------------
# Onboarding web app
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/callback
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Cloud Scheduler (onboarding registers hourly jobs here)
PUBSUB_TOPIC_NAME=inbox-digest-triggers
AGENT_TRIGGER_URL=http://localhost:8080
OIDC_SERVICE_ACCOUNT=inbox-digest-pubsub-invoker@your-project.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# Digest behavior
# ---------------------------------------------------------------------------
MIN_IMPORTANT_TO_SEND=1   # minimum P1+P2 count to trigger a WhatsApp send
MAX_DIGEST_ITEMS=20       # max emails per digest
